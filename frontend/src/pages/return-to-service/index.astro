---
const logoPath = "/logos/logo-background-black-tracium.png";
import AccountMenu from "../../components/AccountMenu.astro";
---

<!doctype html>
<html lang="es">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#23103e" /><title>Retorno al servicio | Tracium</title></head>
  <body>
    <div class="app-layout"><aside class="sidebar"><a class="brand" href="/dashboard/"><img src={logoPath} alt="Tracium" /></a><p class="nav-heading">ESPACIO DE TRABAJO</p><nav><a class="nav-item" href="/dashboard/"><span class="nav-icon">⌂</span>Dashboard</a><a class="nav-item" href="/interventions/"><span class="nav-icon">▤</span>Intervenciones</a><a class="nav-item active" href="/inspections/"><span class="nav-icon">✓</span>Inspecciones</a><a class="nav-item" href="/audit/"><span class="nav-icon">◷</span>Auditoría</a></nav><div class="sidebar-footer"><span class="status-dot"></span>Entorno de demostración</div></aside>
      <main class="main-area"><header class="topbar"><div class="breadcrumb"><a href="/dashboard/">Workspace</a><span>/</span><a href="/inspections/">Inspecciones</a><span>/</span>Retorno al servicio</div><AccountMenu /></header>
        <section class="page-content" aria-labelledby="page-title"><p class="eyebrow">LIBERACIÓN OPERATIVA</p><div class="page-heading"><div><h1 id="page-title">Aprobación de retorno al servicio</h1><p class="intro">Confirma que la intervención y la inspección cumplen los requisitos antes de liberar la aeronave.</p></div></div><p class="page-message" id="page-message" role="status" aria-live="polite"></p><div class="approval-layout"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">VALIDACIONES COMPLETADAS</p><h2>Intervenciones elegibles</h2></div><span class="panel-count" id="record-count">0 registros</span></div><div class="records-list" id="records-list"></div><p class="empty-state" id="empty-state" hidden>No hay intervenciones con inspección aprobada.</p></section><section class="panel approval-panel" id="approval-panel" hidden><p class="eyebrow">DECISIÓN RESPONSABLE</p><h2 id="approval-title">Selecciona una intervención</h2><p class="selected-meta" id="selected-meta"></p><div class="validation-box" id="validation-box"></div><label for="approval-decision">Decisión</label><select id="approval-decision"><option value="approved">Aprobar retorno al servicio</option><option value="rejected">Rechazar y devolver a corrección</option></select><label for="approval-notes">Justificación</label><textarea id="approval-notes" rows="6" maxlength="1200" placeholder="Registra la justificación de la decisión."></textarea><button class="primary-button" id="save-approval" type="button">Guardar decisión</button></section></div></section>
      </main></div>
  </body>
</html>

<script>
  type Intervention = { id: string; aircraft: string; component: string; serialNumber?: string; partNumber?: string; workOrder: string; performedAt: string; description: string; createdAt: string; createdBy: string };
  type Inspection = { decision: string; checks: boolean[]; observations: string; inspector: string; updatedAt: string };
  type Approval = { decision: "approved" | "rejected"; notes: string; responsible: string; updatedAt: string };
  type Details = { status?: string; notes?: string; evidence?: unknown[]; events?: Array<{ id: string; label: string; detail: string; createdAt: string }> };
  const sessionKey = "tracium-demo-user"; const currentUser = localStorage.getItem(sessionKey); if (!currentUser) window.location.replace("/");
  function read<T>(key: string, fallback: T): T { try { return JSON.parse(localStorage.getItem(key) ?? JSON.stringify(fallback)) as T; } catch { return fallback; } }
  const records = read<unknown[]>("tracium-interventions-v1", []).filter((item): item is Intervention => typeof item === "object" && item !== null && ["id", "aircraft", "component", "workOrder", "performedAt", "description", "createdAt", "createdBy"].every((key) => typeof (item as Record<string, unknown>)[key] === "string"));
  const inspections = read<Record<string, Inspection>>("tracium-inspections-v1", {}); const approvals = read<Record<string, Approval>>("tracium-approvals-v1", {}); const details = read<Record<string, Details>>("tracium-intervention-details-v1", {});
  const email = document.querySelector<HTMLSpanElement>("#account-email"); if (email && currentUser) email.textContent = currentUser; document.querySelector<HTMLButtonElement>("#logout-button")?.addEventListener("click", () => { localStorage.removeItem(sessionKey); window.location.replace("/"); });
  const eligible = records.filter((record) => inspections[record.id]?.decision === "approved"); let selected: Intervention | undefined;
  const list = document.querySelector<HTMLDivElement>("#records-list"); const panel = document.querySelector<HTMLElement>("#approval-panel"); const message = document.querySelector<HTMLParagraphElement>("#page-message");
  function render(): void { if (!list) return; list.replaceChildren(); for (const record of eligible) { const approval = approvals[record.id]; const item = document.createElement("button"); item.type = "button"; item.className = `record-row${selected?.id === record.id ? " selected" : ""}`; item.dataset.id = record.id; const title = document.createElement("strong"); title.textContent = `${record.aircraft} · ${record.component}`; const meta = document.createElement("span"); meta.textContent = `${record.workOrder} · P/N ${record.partNumber || "—"} · S/N ${record.serialNumber || "—"} · ${approval ? approval.decision === "approved" ? "Retorno aprobado" : "Rechazado" : "Pendiente de decisión"}`; item.append(title, meta); list.append(item); } document.querySelector("#record-count")!.textContent = `${eligible.length} ${eligible.length === 1 ? "registro" : "registros"}`; (document.querySelector("#empty-state") as HTMLElement).hidden = eligible.length > 0; }
  function openApproval(record: Intervention): void { selected = record; if (!panel) return; panel.hidden = false; document.querySelector("#approval-title")!.textContent = `${record.aircraft} · ${record.workOrder}`; document.querySelector("#selected-meta")!.textContent = `${record.component} · P/N ${record.partNumber || "—"} · S/N ${record.serialNumber || "—"} · Inspección aprobada por ${inspections[record.id]?.inspector ?? "inspector"}`; const approval = approvals[record.id]; (document.querySelector<HTMLSelectElement>("#approval-decision")!).value = approval?.decision ?? "approved"; (document.querySelector<HTMLTextAreaElement>("#approval-notes")!).value = approval?.notes ?? ""; const box = document.querySelector<HTMLDivElement>("#validation-box")!; box.textContent = `Checklist ${inspections[record.id]?.checks.filter(Boolean).length ?? 0}/4 · Evidencias y trazabilidad disponibles en el detalle.`; render(); }
  list?.addEventListener("click", (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-id]"); const record = eligible.find((item) => item.id === button?.dataset.id); if (record) openApproval(record); });
  document.querySelector<HTMLButtonElement>("#save-approval")?.addEventListener("click", () => { if (!selected) return; const decision = (document.querySelector<HTMLSelectElement>("#approval-decision")!).value as Approval["decision"]; const notes = document.querySelector<HTMLTextAreaElement>("#approval-notes")!.value.trim(); const now = new Date().toISOString(); approvals[selected.id] = { decision, notes, responsible: currentUser ?? "usuario demo", updatedAt: now }; localStorage.setItem("tracium-approvals-v1", JSON.stringify(approvals)); const detail = details[selected.id] ?? { status: "approved", notes: "", evidence: [], events: [] }; detail.status = decision === "approved" ? "approved" : "rejected"; detail.events = Array.isArray(detail.events) ? detail.events : []; detail.events.push({ id: crypto.randomUUID(), label: decision === "approved" ? "Retorno al servicio aprobado" : "Retorno al servicio rechazado", detail: `Decisión registrada por ${currentUser ?? "usuario demo"}`, createdAt: now }); details[selected.id] = detail; localStorage.setItem("tracium-intervention-details-v1", JSON.stringify(details)); if (message) message.textContent = "Decisión guardada localmente."; render(); });
  render();
</script>

<style>
  :global(*){box-sizing:border-box}:global(body){min-width:320px;min-height:100vh;margin:0;color:#211b2e;background:#f6f5f8;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}:global(button),:global(input),:global(select),:global(textarea){font:inherit}.sidebar{position:fixed;inset:0 auto 0 0;display:flex;width:254px;flex-direction:column;padding:29px 17px 20px;border-right:1px solid #49365c;background:linear-gradient(180deg,#2e2d4f 0%,#23103e 58%,#351070 100%)}.brand{display:block;width:184px;margin:2px 0 49px 8px}.brand img{width:100%}.nav-heading,.eyebrow{color:#d1c5df;font-size:.68rem;font-weight:750;letter-spacing:.13em}.nav-heading{margin:0 11px 12px}nav{display:grid;gap:5px}.nav-item{display:flex;min-height:44px;align-items:center;gap:12px;padding:0 11px;border-radius:8px;color:#eee8f5;font-size:.87rem;text-decoration:none}.nav-item.active{border-left:3px solid #b249f1;color:#fff;background:#b249f131;font-weight:700}.nav-icon{display:grid;width:21px;place-items:center}.sidebar-footer{display:flex;align-items:center;gap:9px;margin-top:auto;padding:15px 8px 2px;border-top:1px solid #ffffff2e;color:#ded5e8;font-size:.73rem}.status-dot{width:8px;height:8px;border-radius:50%;background:#05b179}.main-area{min-height:100vh;margin-left:254px}.topbar{display:flex;min-height:72px;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(22px,4vw,56px);border-bottom:1px solid #ece9f0;background:#ffffffdb}.breadcrumb{display:flex;gap:10px;color:#352e3f;font-size:.82rem;font-weight:650}.breadcrumb a,.top-link{color:#7902ff;text-decoration:none}.account{display:flex;align-items:center;gap:11px}.account-avatar{display:grid;width:34px;height:34px;place-items:center;border-radius:50%;color:#fff;background:linear-gradient(140deg,#b249f1,#7902ff);font-size:.82rem;font-weight:700}.account-email{color:#4c4457;font-size:.8rem}.top-link{font-size:.74rem;font-weight:700}.logout-button{padding:8px 11px;border:1px solid #e8e3ec;border-radius:7px;color:#62596d;background:#fff;cursor:pointer;font-size:.76rem}.page-content{width:min(100%,1180px);margin:0 auto;padding:clamp(38px,6vh,62px) clamp(22px,4vw,56px)}.eyebrow{margin:0 0 10px;color:#7902ff}.page-heading{margin-bottom:24px}h1,h2,p{margin-top:0}h1{margin-bottom:8px;color:#30263c;font-size:clamp(1.65rem,3vw,2.15rem)}h2{color:#30263c;font-size:1.04rem}.intro{color:#827b8c;font-size:.88rem}.page-message{min-height:20px;color:#08774f;font-size:.78rem}.approval-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(330px,.9fr);gap:18px;align-items:start}.panel{padding:22px;border:1px solid #ece8f0;border-radius:10px;background:#fff;box-shadow:0 3px 12px #23103e08}.panel-heading{display:flex;justify-content:space-between;margin-bottom:18px}.panel-heading .eyebrow{margin-bottom:7px}.panel-count{color:#958c9f;font-size:.72rem}.records-list{display:grid;gap:8px}.record-row{display:block;width:100%;padding:13px 14px;border:1px solid #eeeaf2;border-radius:8px;background:#fff;text-align:left;cursor:pointer}.record-row.selected,.record-row:hover{border-color:#b249f1;background:#fcf8ff}.record-row strong,.record-row span{display:block}.record-row strong{color:#40364b;font-size:.79rem}.record-row span,.selected-meta{margin-top:5px;color:#8f8598;font-size:.7rem}.empty-state{padding:35px 10px;color:#958c9f;font-size:.8rem;text-align:center}.approval-panel[hidden]{display:none}.validation-box{margin:15px 0;padding:12px;border:1px solid #d8f1e8;border-radius:7px;color:#08774f;background:#effaf5;font-size:.74rem;line-height:1.45}.approval-panel label{display:block;margin:16px 0 7px;color:#51465d;font-size:.75rem;font-weight:700}select,textarea{width:100%;padding:10px;border:1px solid #ded8e5;border-radius:7px;color:#40364b;background:#fff;font-size:.8rem}textarea{resize:vertical;line-height:1.5}.primary-button{display:flex;width:100%;min-height:41px;align-items:center;justify-content:center;margin-top:15px;border:1px solid #7902ff;border-radius:7px;color:#fff;background:#7902ff;cursor:pointer;font-size:.78rem;font-weight:700}@media(max-width:900px){.sidebar{position:static;width:auto;padding:17px 18px}.brand{width:155px;margin:0 0 18px}.nav-heading,.sidebar-footer{display:none}nav{grid-template-columns:repeat(4,1fr)}.nav-item{justify-content:center;min-height:38px;padding:0 7px;font-size:.75rem}.main-area{margin-left:0}}@media(max-width:700px){.topbar{align-items:flex-start;flex-direction:column;padding:15px 22px}.account{width:100%}.account-email{flex:1}.approval-layout{grid-template-columns:1fr}}
  .breadcrumb a { color: #898191; font-weight: 450; text-decoration: none; }
  .breadcrumb a:hover { color: #7902ff; }
</style>

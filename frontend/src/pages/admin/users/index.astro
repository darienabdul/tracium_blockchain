---
const logoPath = "/logos/logo-background-black-tracium.png";
import AccountMenu from "../../../components/AccountMenu.astro";
---

<!doctype html>
<AccountMenu fixed />
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#23103e" /><title>Usuarios y permisos | Tracium</title></head>
<body><div class="app-layout"><aside class="sidebar"><a class="brand" href="/dashboard/"><img src={logoPath} alt="Tracium" /></a><p class="nav-heading">ADMINISTRACIÓN</p><nav><a class="nav-item" href="/dashboard/">⌂ <span>Dashboard</span></a><a class="nav-item" href="/interventions/">▤ <span>Intervenciones</span></a><a class="nav-item active" href="/admin/users/">♙ <span>Usuarios y permisos</span></a><a class="nav-item" href="/profile/">⚙ <span>Perfil y configuración</span></a></nav><div class="sidebar-footer"><span class="status-dot"></span>Entorno de demostración</div></aside><main class="main-area"><header class="topbar"><div class="breadcrumb"><a href="/dashboard/">Workspace</a><span>/</span>Administración<span>/</span>Usuarios</div><div class="account"><span class="account-avatar">T</span><span class="account-email" id="account-email">Cuenta demo</span><a class="top-link" href="/profile/">Perfil</a><button class="logout-button" id="logout-button" type="button">Cerrar sesión</button></div></header><section class="page-content" aria-labelledby="page-title"><p class="eyebrow">ADMINISTRACIÓN</p><div class="page-heading"><div><h1 id="page-title">Usuarios y permisos</h1><p class="intro">Administra las personas que participan en el flujo de trazabilidad.</p></div></div><div class="admin-grid"><section class="panel"><div class="panel-heading"><div><p class="eyebrow">DIRECTORIO</p><h2>Usuarios registrados</h2></div><span class="panel-count" id="user-count">0 usuarios</span></div><div class="user-list" id="user-list"></div></section><section class="panel"><p class="eyebrow">NUEVO ACCESO</p><h2>Agregar usuario</h2><form id="user-form"><label for="name">Nombre completo</label><input id="name" required maxlength="80" placeholder="Nombre del usuario" /><label for="email">Correo electrónico</label><input id="email" type="email" required maxlength="120" placeholder="persona@empresa.com" /><label for="role">Rol</label><select id="role"><option>Técnico</option><option>Inspector</option><option>Calidad</option><option>Auditor</option><option>Administrador</option></select><button class="primary-button" type="submit">Guardar usuario</button><p class="form-status" id="form-status" role="status"></p></form></section></div></section></main></div></body></html>

<script>
  type User = { id: string; name: string; email: string; role: string; active: boolean };
  const currentUser = localStorage.getItem("tracium-demo-user"); if (!currentUser) window.location.replace("/");
  function read<T>(key: string, fallback: T): T { try { return JSON.parse(localStorage.getItem(key) ?? JSON.stringify(fallback)) as T; } catch { return fallback; } }
  const users = read<User[]>("tracium-users-v1", [{ id: "demo-admin", name: "Administrador demo", email: "demo@tracium.pro", role: "Administrador", active: true }, { id: "demo-user", name: "Usuario demo", email: "demo2@tracium.pro", role: "Técnico", active: true }]); localStorage.setItem("tracium-users-v1", JSON.stringify(users));
  const emailLabel = document.querySelector<HTMLSpanElement>("#account-email"); if (emailLabel && currentUser) emailLabel.textContent = currentUser; document.querySelector<HTMLButtonElement>("#logout-button")?.addEventListener("click", () => { localStorage.removeItem("tracium-demo-user"); window.location.replace("/"); });
  const list = document.querySelector<HTMLDivElement>("#user-list")!; const form = document.querySelector<HTMLFormElement>("#user-form")!; const status = document.querySelector<HTMLParagraphElement>("#form-status")!;
  function render(): void { list.replaceChildren(); users.forEach((user) => { const row = document.createElement("div"); row.className = "user-row"; const avatar = document.createElement("span"); avatar.className = "user-avatar"; avatar.textContent = user.name.charAt(0).toUpperCase(); const info = document.createElement("div"); info.className = "user-info"; const name = document.createElement("strong"); name.textContent = user.name; const meta = document.createElement("span"); meta.textContent = `${user.email} · ${user.role}`; info.append(name, meta); const toggle = document.createElement("button"); toggle.type = "button"; toggle.className = `user-state ${user.active ? "active" : "inactive"}`; toggle.textContent = user.active ? "Activo" : "Inactivo"; toggle.addEventListener("click", () => { user.active = !user.active; localStorage.setItem("tracium-users-v1", JSON.stringify(users)); render(); }); row.append(avatar, info, toggle); list.append(row); }); document.querySelector("#user-count")!.textContent = `${users.length} ${users.length === 1 ? "usuario" : "usuarios"}`; }
  form.addEventListener("submit", (event) => { event.preventDefault(); const name = (document.querySelector<HTMLInputElement>("#name")!).value.trim(); const email = (document.querySelector<HTMLInputElement>("#email")!).value.trim().toLowerCase(); const role = (document.querySelector<HTMLSelectElement>("#role")!).value; if (users.some((user) => user.email === email)) { status.textContent = "Ya existe un usuario con ese correo."; return; } users.push({ id: crypto.randomUUID(), name, email, role, active: true }); localStorage.setItem("tracium-users-v1", JSON.stringify(users)); form.reset(); status.textContent = "Usuario guardado localmente."; render(); }); render();
</script>

<style>
  :global(*){box-sizing:border-box}:global(body){min-width:320px;min-height:100vh;margin:0;color:#211b2e;background:#f6f5f8;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}:global(button),:global(input),:global(select){font:inherit}.sidebar{position:fixed;inset:0 auto 0 0;display:flex;width:254px;flex-direction:column;padding:29px 17px 20px;border-right:1px solid #49365c;background:linear-gradient(180deg,#2e2d4f 0%,#23103e 58%,#351070 100%)}.brand{display:block;width:184px;margin:2px 0 49px 8px}.brand img{width:100%}.nav-heading,.eyebrow{color:#d1c5df;font-size:.68rem;font-weight:750;letter-spacing:.13em}.nav-heading{margin:0 11px 12px}nav{display:grid;gap:5px}.nav-item{display:flex;min-height:44px;align-items:center;gap:12px;padding:0 11px;border-radius:8px;color:#eee8f5;font-size:.87rem;text-decoration:none}.nav-item.active{border-left:3px solid #b249f1;color:#fff;background:#b249f131;font-weight:700}.sidebar-footer{display:flex;align-items:center;gap:9px;margin-top:auto;padding:15px 8px 2px;border-top:1px solid #ffffff2e;color:#ded5e8;font-size:.73rem}.status-dot{width:8px;height:8px;border-radius:50%;background:#05b179}.main-area{min-height:100vh;margin-left:254px}.topbar{display:flex;min-height:72px;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(22px,4vw,56px);border-bottom:1px solid #ece9f0;background:#ffffffdb}.breadcrumb{display:flex;gap:10px;color:#352e3f;font-size:.82rem;font-weight:650}.breadcrumb a,.top-link{color:#7902ff;text-decoration:none}.account{display:flex;align-items:center;gap:11px}.account-avatar,.user-avatar{display:grid;place-items:center;border-radius:50%;color:#fff;background:linear-gradient(140deg,#b249f1,#7902ff);font-weight:700}.account-avatar{width:34px;height:34px;font-size:.82rem}.account-email{color:#4c4457;font-size:.8rem}.top-link{font-size:.74rem;font-weight:700}.logout-button{padding:8px 11px;border:1px solid #e8e3ec;border-radius:7px;color:#62596d;background:#fff;cursor:pointer;font-size:.76rem}.page-content{width:min(100%,1180px);margin:0 auto;padding:clamp(38px,6vh,62px) clamp(22px,4vw,56px)}.eyebrow{margin:0 0 10px;color:#7902ff}.page-heading{margin-bottom:25px}h1,h2,p{margin-top:0}h1{margin-bottom:8px;color:#30263c;font-size:clamp(1.65rem,3vw,2.15rem)}h2{color:#30263c;font-size:1.04rem}.intro{color:#827b8c;font-size:.88rem}.admin-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:18px;align-items:start}.panel{padding:22px;border:1px solid #ece8f0;border-radius:10px;background:#fff}.panel-heading{display:flex;justify-content:space-between;margin-bottom:18px}.panel-heading .eyebrow{margin-bottom:7px}.panel-count{color:#958c9f;font-size:.72rem}.user-list{display:grid;gap:8px}.user-row{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid #eeeaf2;border-radius:8px}.user-avatar{width:34px;height:34px;flex:0 0 auto;font-size:.8rem}.user-info{min-width:0;flex:1}.user-info strong,.user-info span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.user-info strong{color:#44394f;font-size:.78rem}.user-info span{margin-top:4px;color:#8f8598;font-size:.69rem}.user-state{padding:5px 9px;border:0;border-radius:12px;cursor:pointer;font-size:.65rem;font-weight:700}.user-state.active{color:#08774f;background:#effaf5}.user-state.inactive{color:#9a5b00;background:#fff8e9}label{display:block;margin:15px 0 7px;color:#51465d;font-size:.75rem;font-weight:700}input,select{width:100%;height:42px;padding:0 11px;border:1px solid #ded8e5;border-radius:7px;color:#40364b;background:#fff;font-size:.8rem}.primary-button{width:100%;height:42px;margin-top:19px;border:1px solid #7902ff;border-radius:7px;color:#fff;background:#7902ff;cursor:pointer;font-size:.78rem;font-weight:700}.form-status{min-height:18px;margin:11px 0 0;color:#08774f;font-size:.75rem}@media(max-width:900px){.sidebar{position:static;width:auto;padding:17px 18px}.brand{width:155px;margin:0 0 18px}.nav-heading,.sidebar-footer{display:none}nav{grid-template-columns:repeat(4,1fr)}.nav-item{justify-content:center;min-height:38px;font-size:.75rem}.main-area{margin-left:0}}@media(max-width:700px){.topbar{align-items:flex-start;flex-direction:column;padding:15px 22px}.account{width:100%}.account-email{flex:1}.admin-grid{grid-template-columns:1fr}}
  .breadcrumb a { color: #898191; font-weight: 450; text-decoration: none; }
  .breadcrumb a:hover { color: #7902ff; }
</style>

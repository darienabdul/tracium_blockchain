---
import AccountMenu from "../../components/AccountMenu.astro";

const logoPath = "/logos/logo-background-black-tracium.png";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#23103e" />
    <title>Auditoría | Tracium</title>
  </head>
  <body>
    <div class="app-layout">
      <aside class="sidebar">
        <a class="brand" href="/dashboard/"><img src={logoPath} alt="Tracium" /></a>
        <p class="nav-heading">ESPACIO DE TRABAJO</p>
        <nav aria-label="Menú principal">
          <a class="nav-item" href="/dashboard/"><span class="nav-icon" aria-hidden="true">⌂</span>Dashboard</a>
          <a class="nav-item" href="/interventions/"><span class="nav-icon" aria-hidden="true">▤</span>Intervenciones</a>
          <a class="nav-item" href="/inspections/"><span class="nav-icon" aria-hidden="true">✓</span>Inspecciones</a>
          <a class="nav-item active" href="/audit/" aria-current="page"><span class="nav-icon" aria-hidden="true">◷</span>Auditoría</a>
        </nav>
        <div class="sidebar-footer"><span class="status-dot" aria-hidden="true"></span>Entorno de demostración</div>
      </aside>

      <main class="main-area">
        <header class="topbar">
          <div class="breadcrumb"><a href="/dashboard/">Workspace</a><span aria-hidden="true">/</span>Auditoría</div>
          <AccountMenu />
        </header>

        <section class="page-content" aria-labelledby="page-title">
          <p class="eyebrow">CONTROL Y TRAZABILIDAD</p>
          <div class="page-heading">
            <div>
              <h1 id="page-title">Historial de auditoría</h1>
              <p class="intro">Consulta la secuencia de acciones, responsables y referencias verificables del workspace.</p>
            </div>
            <span class="stellar-badge">● Stellar pendiente de integración</span>
          </div>

          <div class="toolbar">
            <label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Buscar por aeronave, ID o responsable…" /></label>
            <select id="event-filter" aria-label="Filtrar eventos">
              <option value="all">Todos los eventos</option>
              <option value="intervention">Intervenciones</option>
              <option value="inspection">Inspecciones</option>
              <option value="approval">Aprobaciones</option>
            </select>
          </div>

          <section class="panel" aria-labelledby="events-title">
            <div class="panel-heading">
              <div><p class="eyebrow">LÍNEA DE TIEMPO</p><h2 id="events-title">Eventos registrados</h2></div>
              <span class="panel-count" id="event-count">0 eventos</span>
            </div>
            <div class="timeline" id="timeline"></div>
            <p class="empty-state" id="empty-state" hidden>No hay eventos que coincidan con la búsqueda.</p>
          </section>
        </section>
      </main>
    </div>
  </body>
</html>

<script>
  type Intervention = { id: string; aircraft: string; component: string; workOrder: string; createdAt: string; createdBy: string };
  type AuditEvent = { id: string; recordId: string; category: "intervention" | "inspection" | "approval"; label: string; detail: string; actor: string; createdAt: string };
  type DetailEvent = { id: string; label: string; detail: string; createdAt: string };

  const sessionKey = "tracium-demo-user";
  const currentUser = localStorage.getItem(sessionKey);
  if (!currentUser) window.location.replace("/");

  function read<T>(key: string, fallback: T): T {
    try { return JSON.parse(localStorage.getItem(key) ?? JSON.stringify(fallback)) as T; }
    catch { return fallback; }
  }

  const records = read<unknown[]>("tracium-interventions-v1", []).filter((item): item is Intervention => {
    if (typeof item !== "object" || item === null) return false;
    const record = item as Record<string, unknown>;
    return ["id", "aircraft", "component", "workOrder", "createdAt", "createdBy"]
      .every((key) => typeof record[key] === "string");
  });
  const details = read<Record<string, { events?: DetailEvent[] }>>("tracium-intervention-details-v1", {});
  const inspections = read<Record<string, { inspector: string; decision: string; updatedAt: string }>>("tracium-inspections-v1", {});
  const approvals = read<Record<string, { responsible: string; decision: string; updatedAt: string }>>("tracium-approvals-v1", {});
  const events: AuditEvent[] = [];

  for (const record of records) {
    events.push({ id: `created-${record.id}`, recordId: record.id, category: "intervention", label: "Intervención registrada", detail: `${record.aircraft} · ${record.workOrder}`, actor: record.createdBy, createdAt: record.createdAt });
    for (const event of details[record.id]?.events ?? []) {
      const normalized = event.label.toLocaleLowerCase("es");
      events.push({ id: event.id, recordId: record.id, category: normalized.includes("inspección") ? "inspection" : normalized.includes("retorno") ? "approval" : "intervention", label: event.label, detail: event.detail, actor: event.detail.split(" por ").pop() ?? "usuario demo", createdAt: event.createdAt });
    }
    const inspection = inspections[record.id];
    if (inspection) events.push({ id: `inspection-${record.id}`, recordId: record.id, category: "inspection", label: `Inspección ${inspection.decision}`, detail: "Resultado de checklist de inspección", actor: inspection.inspector, createdAt: inspection.updatedAt });
    const approval = approvals[record.id];
    if (approval) events.push({ id: `approval-${record.id}`, recordId: record.id, category: "approval", label: `Retorno al servicio ${approval.decision === "approved" ? "aprobado" : "rechazado"}`, detail: "Decisión de liberación operativa", actor: approval.responsible, createdAt: approval.updatedAt });
  }

  const timeline = document.querySelector<HTMLDivElement>("#timeline")!;
  const search = document.querySelector<HTMLInputElement>("#search")!;
  const filter = document.querySelector<HTMLSelectElement>("#event-filter")!;
  const empty = document.querySelector<HTMLElement>("#empty-state")!;
  const formatDate = (value: string): string => new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short" }).format(new Date(value));

  function render(): void {
    const query = search.value.trim().toLocaleLowerCase("es");
    const selected = filter.value;
    const filtered = events.filter((event) => (selected === "all" || event.category === selected) && [event.recordId, event.label, event.detail, event.actor].some((value) => value.toLocaleLowerCase("es").includes(query))).sort((first, second) => second.createdAt.localeCompare(first.createdAt));
    timeline.replaceChildren();
    for (const event of filtered) {
      const item = document.createElement("article"); item.className = `timeline-item ${event.category}`;
      const marker = document.createElement("span"); marker.className = "timeline-marker";
      const body = document.createElement("div"); const label = document.createElement("strong"); label.textContent = event.label;
      const detail = document.createElement("p"); detail.textContent = `${event.detail} · ${event.recordId}`;
      const meta = document.createElement("small"); meta.textContent = `${event.actor} · ${formatDate(event.createdAt)}`;
      body.append(label, detail, meta); item.append(marker, body); timeline.append(item);
    }
    document.querySelector("#event-count")!.textContent = `${filtered.length} ${filtered.length === 1 ? "evento" : "eventos"}`;
    empty.hidden = filtered.length > 0;
  }
  search.addEventListener("input", render); filter.addEventListener("change", render); render();
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { min-width: 320px; min-height: 100vh; margin: 0; color: #211b2e; background: #f6f5f8; font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
  :global(button), :global(input), :global(select) { font: inherit; }
  .sidebar { position: fixed; inset: 0 auto 0 0; display: flex; width: 254px; flex-direction: column; padding: 29px 17px 20px; border-right: 1px solid #49365c; background: linear-gradient(180deg, #2e2d4f 0%, #23103e 58%, #351070 100%); }
  .brand { display: block; width: 184px; margin: 2px 0 49px 8px; }
  .brand img { display: block; width: 100%; }
  .nav-heading, .eyebrow { color: #d1c5df; font-size: .68rem; font-weight: 750; letter-spacing: .13em; }
  .nav-heading { margin: 0 11px 12px; }
  nav { display: grid; gap: 5px; }
  .nav-item { display: flex; min-height: 44px; align-items: center; gap: 12px; padding: 0 11px; border-radius: 8px; color: #eee8f5; font-size: .87rem; text-decoration: none; }
  .nav-item.active { border-left: 3px solid #b249f1; color: #fff; background: rgb(178 73 241 / 19%); font-weight: 700; }
  .nav-icon { display: grid; width: 21px; place-items: center; }
  .sidebar-footer { display: flex; align-items: center; gap: 9px; margin-top: auto; padding: 15px 8px 2px; border-top: 1px solid rgb(255 255 255 / 18%); color: #ded5e8; font-size: .73rem; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #05b179; }
  .main-area { min-height: 100vh; margin-left: 254px; }
  .topbar { display: flex; min-height: 72px; align-items: center; justify-content: space-between; gap: 16px; padding: 0 clamp(22px, 4vw, 56px); border-bottom: 1px solid #ece9f0; background: rgb(255 255 255 / 86%); }
  .breadcrumb { display: flex; gap: 10px; color: #352e3f; font-size: .82rem; font-weight: 650; }
  .breadcrumb a { color: #898191; font-weight: 450; text-decoration: none; }
  .breadcrumb a:hover { color: #7902ff; }
  .page-content { width: min(100%, 1180px); margin: 0 auto; padding: clamp(38px, 6vh, 62px) clamp(22px, 4vw, 56px); }
  .eyebrow { margin: 0 0 10px; color: #7902ff; }
  .page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
  h1, h2, p { margin-top: 0; } h1 { margin-bottom: 8px; color: #30263c; font-size: clamp(1.65rem, 3vw, 2.15rem); } h2 { color: #30263c; font-size: 1.04rem; }
  .intro { margin: 0; color: #827b8c; font-size: .88rem; }
  .stellar-badge { padding: 7px 10px; border-radius: 14px; color: #8a6b13; background: #fff7dd; font-size: .68rem; font-weight: 700; white-space: nowrap; }
  .toolbar { display: flex; gap: 10px; margin-bottom: 18px; }
  .search { display: flex; flex: 1; align-items: center; gap: 7px; padding: 0 11px; border: 1px solid #ded8e5; border-radius: 7px; background: #fff; }
  .search span { color: #958c9f; } .search input { width: 100%; height: 41px; border: 0; outline: 0; color: #40364b; font-size: .8rem; }
  .toolbar select { width: 190px; padding: 0 10px; border: 1px solid #ded8e5; border-radius: 7px; color: #40364b; background: #fff; font-size: .78rem; }
  .panel { padding: 22px; border: 1px solid #ece8f0; border-radius: 10px; background: #fff; }
  .panel-heading { display: flex; justify-content: space-between; margin-bottom: 18px; } .panel-heading .eyebrow { margin-bottom: 7px; } .panel-count { color: #958c9f; font-size: .72rem; }
  .timeline { display: grid; gap: 0; } .timeline-item { position: relative; display: grid; grid-template-columns: 18px 1fr; gap: 12px; min-height: 72px; }
  .timeline-item:not(:last-child)::before { position: absolute; top: 16px; bottom: 0; left: 6px; width: 1px; background: #e5ddec; content: ""; }
  .timeline-marker { position: relative; z-index: 1; width: 13px; height: 13px; margin-top: 2px; border: 3px solid #eadcf5; border-radius: 50%; background: #7902ff; }
  .timeline-item.inspection .timeline-marker { background: #facf1e; } .timeline-item.approval .timeline-marker { background: #05b179; }
  .timeline-item strong { display: block; color: #4a4054; font-size: .78rem; } .timeline-item p { margin: 4px 0; color: #7b7285; font-size: .73rem; } .timeline-item small { color: #a097a8; font-size: .67rem; }
  .empty-state { padding: 35px; color: #958c9f; text-align: center; font-size: .8rem; } .empty-state[hidden] { display: none; }
  @media (max-width: 900px) { .sidebar { position: static; width: auto; padding: 17px 18px; } .brand { width: 155px; margin: 0 0 18px; } .nav-heading, .sidebar-footer { display: none; } nav { grid-template-columns: repeat(4, 1fr); } .nav-item { justify-content: center; min-height: 38px; font-size: .75rem; } .main-area { margin-left: 0; } }
  @media (max-width: 700px) { .topbar { align-items: flex-start; flex-direction: column; padding: 15px 22px; } .page-heading, .toolbar { align-items: flex-start; flex-direction: column; } .toolbar select { width: 100%; } .stellar-badge { white-space: normal; } }
</style>

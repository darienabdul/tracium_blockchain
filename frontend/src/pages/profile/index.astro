---
const logoPath = "/logos/logo-background-black-tracium.png";
import AccountMenu from "../../components/AccountMenu.astro";
---

<!doctype html>
<AccountMenu fixed />
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#23103e" /><title>Perfil y configuración | Tracium</title></head>
<body><div class="app-layout"><aside class="sidebar"><a class="brand" href="/dashboard/"><img src={logoPath} alt="Tracium" /></a><p class="nav-heading">CONFIGURACIÓN</p><nav><a class="nav-item" href="/dashboard/">⌂ <span>Dashboard</span></a><a class="nav-item" href="/interventions/">▤ <span>Intervenciones</span></a><a class="nav-item" href="/admin/users/">♙ <span>Usuarios y permisos</span></a><a class="nav-item active" href="/profile/">⚙ <span>Perfil y configuración</span></a></nav><div class="sidebar-footer"><span class="status-dot"></span>Entorno de demostración</div></aside><main class="main-area"><header class="topbar"><div class="breadcrumb"><a href="/dashboard/">Workspace</a><span>/</span>Perfil y configuración</div><div class="account"><span class="account-avatar">T</span><span class="account-email" id="account-email">Cuenta demo</span><button class="logout-button" id="logout-button" type="button">Cerrar sesión</button></div></header><section class="page-content" aria-labelledby="page-title"><p class="eyebrow">CUENTA</p><div class="page-heading"><div><h1 id="page-title">Perfil y configuración</h1><p class="intro">Personaliza tu información y preferencias para el entorno de trabajo.</p></div></div><div class="profile-grid"><section class="panel"><p class="eyebrow">INFORMACIÓN PERSONAL</p><h2>Perfil del usuario</h2><form id="profile-form"><label for="name">Nombre completo</label><input id="name" maxlength="80" placeholder="Nombre completo" /><label for="phone">Teléfono</label><input id="phone" maxlength="30" placeholder="+57 300 000 0000" /><label for="organization">Organización</label><input id="organization" maxlength="100" placeholder="Organización o taller" /><label for="timezone">Zona horaria</label><select id="timezone"><option value="America/Bogota">Bogotá (UTC-5)</option><option value="America/Mexico_City">Ciudad de México</option><option value="UTC">UTC</option></select><button class="primary-button" type="submit">Guardar perfil</button><p class="form-status" id="form-status" role="status"></p></form></section><section class="panel"><p class="eyebrow">PREFERENCIAS</p><h2>Experiencia de uso</h2><label class="toggle-row"><span><strong>Notificaciones de inspección</strong><small>Mostrar avisos sobre revisiones pendientes.</small></span><input id="inspection-notifications" type="checkbox" /></label><label class="toggle-row"><span><strong>Resumen en el dashboard</strong><small>Mostrar indicadores operativos al iniciar.</small></span><input id="dashboard-summary" type="checkbox" /></label><button class="secondary-button" id="save-preferences" type="button">Guardar preferencias</button><div class="account-box"><strong id="account-title">Cuenta local</strong><span id="account-role">Rol demo · Datos almacenados en este navegador</span></div></section></div></section></main></div></body></html>

<script>
  type Profile = { name: string; phone: string; organization: string; timezone: string; inspectionNotifications: boolean; dashboardSummary: boolean };
  const currentUser = localStorage.getItem("tracium-demo-user"); if (!currentUser) window.location.replace("/");
  const key = `tracium-profile-v1-${currentUser ?? "demo"}`; const read = (): Profile => { try { return JSON.parse(localStorage.getItem(key) ?? "{}") as Profile; } catch { return {} as Profile; } }; const profile = read();
  const email = document.querySelector<HTMLSpanElement>("#account-email"); if (email && currentUser) email.textContent = currentUser; document.querySelector<HTMLButtonElement>("#logout-button")?.addEventListener("click", () => { localStorage.removeItem("tracium-demo-user"); window.location.replace("/"); });
  const set = (selector: string, value: string | boolean): void => { const element = document.querySelector<HTMLInputElement | HTMLSelectElement>(selector); if (!element) return; if (element instanceof HTMLInputElement && element.type === "checkbox") element.checked = Boolean(value); else element.value = String(value ?? ""); };
  set("#name", profile.name ?? ""); set("#phone", profile.phone ?? ""); set("#organization", profile.organization ?? ""); set("#timezone", profile.timezone ?? "America/Bogota"); set("#inspection-notifications", profile.inspectionNotifications ?? true); set("#dashboard-summary", profile.dashboardSummary ?? true); document.querySelector("#account-title")!.textContent = currentUser ?? "Cuenta local";
  const save = (): void => { const next: Profile = { name: (document.querySelector<HTMLInputElement>("#name")!).value.trim(), phone: (document.querySelector<HTMLInputElement>("#phone")!).value.trim(), organization: (document.querySelector<HTMLInputElement>("#organization")!).value.trim(), timezone: (document.querySelector<HTMLSelectElement>("#timezone")!).value, inspectionNotifications: (document.querySelector<HTMLInputElement>("#inspection-notifications")!).checked, dashboardSummary: (document.querySelector<HTMLInputElement>("#dashboard-summary")!).checked }; localStorage.setItem(key, JSON.stringify(next)); (document.querySelector<HTMLParagraphElement>("#form-status")!).textContent = "Perfil guardado localmente."; };
  document.querySelector<HTMLFormElement>("#profile-form")?.addEventListener("submit", (event) => { event.preventDefault(); save(); }); document.querySelector<HTMLButtonElement>("#save-preferences")?.addEventListener("click", save);
</script>

<style>
  :global(*){box-sizing:border-box}:global(body){min-width:320px;min-height:100vh;margin:0;color:#211b2e;background:#f6f5f8;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}:global(button),:global(input),:global(select){font:inherit}.sidebar{position:fixed;inset:0 auto 0 0;display:flex;width:254px;flex-direction:column;padding:29px 17px 20px;border-right:1px solid #49365c;background:linear-gradient(180deg,#2e2d4f 0%,#23103e 58%,#351070 100%)}.brand{display:block;width:184px;margin:2px 0 49px 8px}.brand img{width:100%}.nav-heading,.eyebrow{color:#d1c5df;font-size:.68rem;font-weight:750;letter-spacing:.13em}.nav-heading{margin:0 11px 12px}nav{display:grid;gap:5px}.nav-item{display:flex;min-height:44px;align-items:center;gap:12px;padding:0 11px;border-radius:8px;color:#eee8f5;font-size:.87rem;text-decoration:none}.nav-item.active{border-left:3px solid #b249f1;color:#fff;background:#b249f131;font-weight:700}.sidebar-footer{display:flex;align-items:center;gap:9px;margin-top:auto;padding:15px 8px 2px;border-top:1px solid #ffffff2e;color:#ded5e8;font-size:.73rem}.status-dot{width:8px;height:8px;border-radius:50%;background:#05b179}.main-area{min-height:100vh;margin-left:254px}.topbar{display:flex;min-height:72px;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(22px,4vw,56px);border-bottom:1px solid #ece9f0;background:#ffffffdb}.breadcrumb{display:flex;gap:10px;color:#352e3f;font-size:.82rem;font-weight:650}.breadcrumb a{color:#7902ff;text-decoration:none}.account{display:flex;align-items:center;gap:11px}.account-avatar{display:grid;width:34px;height:34px;place-items:center;border-radius:50%;color:#fff;background:linear-gradient(140deg,#b249f1,#7902ff);font-size:.82rem;font-weight:700}.account-email{color:#4c4457;font-size:.8rem}.logout-button{padding:8px 11px;border:1px solid #e8e3ec;border-radius:7px;color:#62596d;background:#fff;cursor:pointer;font-size:.76rem}.page-content{width:min(100%,1060px);margin:0 auto;padding:clamp(38px,6vh,62px) clamp(22px,4vw,56px)}.eyebrow{margin:0 0 10px;color:#7902ff}.page-heading{margin-bottom:25px}h1,h2,p{margin-top:0}h1{margin-bottom:8px;color:#30263c;font-size:clamp(1.65rem,3vw,2.15rem)}h2{color:#30263c;font-size:1.04rem}.intro{color:#827b8c;font-size:.88rem}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}.panel{padding:22px;border:1px solid #ece8f0;border-radius:10px;background:#fff}.panel h2{margin-bottom:20px}label:not(.toggle-row){display:block;margin:15px 0 7px;color:#51465d;font-size:.75rem;font-weight:700}input,select{width:100%;height:42px;padding:0 11px;border:1px solid #ded8e5;border-radius:7px;color:#40364b;background:#fff;font-size:.8rem}.primary-button,.secondary-button{width:100%;height:42px;margin-top:19px;border-radius:7px;cursor:pointer;font-size:.78rem;font-weight:700}.primary-button{border:1px solid #7902ff;color:#fff;background:#7902ff}.secondary-button{border:1px solid #ded3ed;color:#60338f;background:#fff}.form-status{min-height:18px;margin:11px 0 0;color:#08774f;font-size:.75rem}.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:17px;padding-bottom:15px;border-bottom:1px solid #f0edf3}.toggle-row strong,.toggle-row small{display:block}.toggle-row strong{color:#4b4056;font-size:.78rem}.toggle-row small{margin-top:4px;color:#958c9f;font-size:.69rem}.toggle-row input{width:36px;height:20px;accent-color:#7902ff}.account-box{margin-top:25px;padding:14px;border-radius:7px;background:#faf7fd}.account-box strong,.account-box span{display:block}.account-box strong{color:#513478;font-size:.76rem}.account-box span{margin-top:4px;color:#8f8598;font-size:.69rem}@media(max-width:900px){.sidebar{position:static;width:auto;padding:17px 18px}.brand{width:155px;margin:0 0 18px}.nav-heading,.sidebar-footer{display:none}nav{grid-template-columns:repeat(4,1fr)}.nav-item{justify-content:center;min-height:38px;font-size:.75rem}.main-area{margin-left:0}}@media(max-width:700px){.topbar{align-items:flex-start;flex-direction:column;padding:15px 22px}.account{width:100%}.account-email{flex:1}.profile-grid{grid-template-columns:1fr}}
  .breadcrumb a { color: #898191; font-weight: 450; text-decoration: none; }
  .breadcrumb a:hover { color: #7902ff; }
</style>

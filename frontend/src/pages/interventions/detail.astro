---
const logoPath = "/logos/logo-background-black-tracium.png";
import AccountMenu from "../../components/AccountMenu.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#23103e" />
    <meta
      name="description"
      content="Detalle y trazabilidad de una intervención de mantenimiento en Tracium."
    />
    <title>Detalle de intervención | Tracium</title>
  </head>
  <body>
    <div class="app-layout">
      <aside class="sidebar">
        <a class="brand" href="/dashboard/" aria-label="Tracium, inicio">
          <img src={logoPath} alt="Tracium" />
        </a>

        <p class="nav-heading">ESPACIO DE TRABAJO</p>
        <nav aria-label="Menú principal">
          <a class="nav-item" href="/dashboard/">
            <span class="nav-icon" aria-hidden="true">⌂</span>
            Dashboard
          </a>
          <a class="nav-item active" href="/interventions/" aria-current="page">
            <span class="nav-icon" aria-hidden="true">▤</span>
            Intervenciones
          </a>
          <a class="nav-item" href="/inspections/">
            <span class="nav-icon" aria-hidden="true">✓</span>
            Inspecciones
          </a>
          <a class="nav-item" href="/audit/">
            <span class="nav-icon" aria-hidden="true">◷</span>
            Auditoría
          </a>
        </nav>

        <div class="sidebar-footer">
          <span class="status-dot" aria-hidden="true"></span>
          Entorno de demostración
        </div>
      </aside>

      <main class="main-area">
        <header class="topbar">
          <div class="breadcrumb">
            <a href="/dashboard/">Workspace</a><span aria-hidden="true">/</span>
            <a href="/interventions/">Intervenciones</a><span aria-hidden="true">/</span>Detalle
          </div>
          <AccountMenu />
        </header>

        <section class="page-content" id="detail-content" aria-labelledby="page-title">
          <a class="back-link" href="/interventions/">← Volver a intervenciones</a>

          <div class="page-heading">
            <div>
              <p class="eyebrow">DETALLE DE MANTENIMIENTO</p>
              <h1 id="page-title">Intervención</h1>
              <p class="intro" id="page-subtitle">Consulta la información y el avance de esta intervención.</p>
            </div>
            <div class="heading-actions">
              <a class="secondary-button edit-button" id="edit-button" href="#">Editar intervención</a>
              <span class="status-pill status-registered" id="status-badge">Registrada</span>
            </div>
          </div>

          <p class="page-message" id="page-message" role="status" aria-live="polite"></p>

          <div class="detail-grid">
            <div class="detail-main">
              <section class="panel" aria-labelledby="summary-title">
                <div class="panel-heading">
                  <div>
                    <p class="eyebrow">REGISTRO BASE</p>
                    <h2 id="summary-title">Resumen de la intervención</h2>
                  </div>
                  <span class="record-id" id="record-id"></span>
                </div>

                <dl class="details-list">
                  <div><dt>Aeronave</dt><dd id="aircraft"></dd></div>
                  <div><dt>Componente</dt><dd id="component"></dd></div>
                  <div><dt>Orden de trabajo</dt><dd id="work-order"></dd></div>
                  <div><dt>Trabajo realizado</dt><dd id="performed-at"></dd></div>
                  <div><dt>Registrada por</dt><dd id="created-by"></dd></div>
                  <div><dt>Fecha de registro</dt><dd id="created-at"></dd></div>
                </dl>

                <div class="description-block">
                  <h3>Descripción del trabajo</h3>
                  <p id="description"></p>
                </div>
              </section>

              <section class="panel" aria-labelledby="evidence-title">
                <div class="panel-heading">
                  <div>
                    <p class="eyebrow">SOPORTE DOCUMENTAL</p>
                    <h2 id="evidence-title">Evidencias</h2>
                  </div>
                  <span class="panel-count" id="evidence-count">0 archivos</span>
                </div>
                <p class="panel-intro">Adjunta documentos o imágenes relacionados con el trabajo realizado.</p>
                <label class="upload-box" for="evidence-input">
                  <span class="upload-icon" aria-hidden="true">＋</span>
                  <span><strong>Agregar evidencia</strong><small>Imágenes o PDF · máximo 1.5 MB por archivo</small></span>
                  <input id="evidence-input" type="file" accept="image/*,.pdf" />
                </label>
                <div class="evidence-list" id="evidence-list"></div>
                <p class="empty-inline" id="evidence-empty">Todavía no hay evidencias asociadas.</p>
              </section>

              <section class="panel" aria-labelledby="timeline-title">
                <div class="panel-heading">
                  <div>
                    <p class="eyebrow">TRAZABILIDAD</p>
                    <h2 id="timeline-title">Línea de tiempo</h2>
                  </div>
                  <span class="stellar-badge"><span aria-hidden="true">●</span> Stellar pendiente</span>
                </div>
                <div class="timeline" id="timeline"></div>
              </section>
            </div>

            <aside class="detail-side">
              <section class="panel flow-panel" aria-labelledby="flow-title">
                <p class="eyebrow">FLUJO OPERATIVO</p>
                <h2 id="flow-title">Estado de la intervención</h2>
                <p class="panel-intro">Actualiza el avance del registro para preparar la inspección y la aprobación.</p>
                <label class="field-label" for="status-input">Estado</label>
                <select id="status-input">
                  <option value="registered">Registrada</option>
                  <option value="inspection">En inspección</option>
                  <option value="approved">Aprobada</option>
                  <option value="rejected">Rechazada</option>
                </select>
                <button class="primary-button" id="save-status" type="button">Guardar estado</button>
              </section>

              <section class="panel" aria-labelledby="notes-title">
                <p class="eyebrow">CONTROL DE CALIDAD</p>
                <h2 id="notes-title">Observaciones</h2>
                <p class="panel-intro">Registra notas para la próxima revisión o inspección.</p>
                <textarea id="notes-input" rows="6" maxlength="1200" placeholder="Escribe una observación…"></textarea>
                <button class="secondary-button" id="save-notes" type="button">Guardar observación</button>
              </section>

              <section class="panel verification-panel" aria-labelledby="verification-title">
                <p class="eyebrow">VERIFICACIÓN</p>
                <h2 id="verification-title">Referencia verificable</h2>
                <p class="panel-intro">La referencia de Stellar aparecerá cuando el flujo de integración esté conectado.</p>
                <div class="verification-placeholder"><span aria-hidden="true">◷</span> Pendiente de integración</div>
              </section>
            </aside>
          </div>
        </section>

        <section class="not-found" id="not-found" hidden aria-labelledby="not-found-title">
          <div class="not-found-icon" aria-hidden="true">?</div>
          <p class="eyebrow">REGISTRO NO DISPONIBLE</p>
          <h1 id="not-found-title">No encontramos esta intervención</h1>
          <p>Puede que el registro haya sido eliminado o que el enlace ya no sea válido.</p>
          <a class="primary-button link-button" href="/interventions/">Volver a intervenciones</a>
        </section>
      </main>
    </div>
  </body>
</html>

<script>
  type Intervention = {
    id: string;
    aircraft: string;
    component: string;
    workOrder: string;
    performedAt: string;
    description: string;
    createdAt: string;
    createdBy: string;
  };

  type Status = "registered" | "inspection" | "approved" | "rejected";

  type Evidence = {
    id: string;
    name: string;
    type: string;
    dataUrl: string;
    addedAt: string;
  };

  type TimelineEvent = {
    id: string;
    label: string;
    detail: string;
    createdAt: string;
  };

  type DetailState = {
    status: Status;
    notes: string;
    evidence: Evidence[];
    events: TimelineEvent[];
  };

  const sessionKey = "tracium-demo-user";
  const interventionsKey = "tracium-interventions-v1";
  const detailsKey = "tracium-intervention-details-v1";
  const currentUser = localStorage.getItem(sessionKey);

  if (!currentUser) {
    window.location.replace("/");
  }

  const params = new URLSearchParams(window.location.search);
  const interventionId = params.get("id");
  const detailContent = document.querySelector<HTMLElement>("#detail-content");
  const notFound = document.querySelector<HTMLElement>("#not-found");
  const emailLabel = document.querySelector<HTMLSpanElement>("#account-email");
  const logoutButton = document.querySelector<HTMLButtonElement>("#logout-button");
  const pageMessage = document.querySelector<HTMLParagraphElement>("#page-message");
  const statusBadge = document.querySelector<HTMLSpanElement>("#status-badge");
  const statusInput = document.querySelector<HTMLSelectElement>("#status-input");
  const notesInput = document.querySelector<HTMLTextAreaElement>("#notes-input");
  const evidenceInput = document.querySelector<HTMLInputElement>("#evidence-input");
  const evidenceList = document.querySelector<HTMLDivElement>("#evidence-list");
  const evidenceEmpty = document.querySelector<HTMLParagraphElement>("#evidence-empty");
  const evidenceCount = document.querySelector<HTMLSpanElement>("#evidence-count");
  const timeline = document.querySelector<HTMLDivElement>("#timeline");

  if (emailLabel && currentUser) {
    emailLabel.textContent = currentUser;
  }

  logoutButton?.addEventListener("click", () => {
    localStorage.removeItem(sessionKey);
    window.location.replace("/");
  });

  function formatDate(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "Fecha no disponible";
    return new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short" }).format(date);
  }

  function isIntervention(value: unknown): value is Intervention {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return ["id", "aircraft", "component", "workOrder", "performedAt", "description", "createdAt", "createdBy"]
      .every((key) => typeof record[key] === "string");
  }

  function readInterventions(): Intervention[] {
    try {
      const value: unknown = JSON.parse(localStorage.getItem(interventionsKey) ?? "[]");
      return Array.isArray(value) ? value.filter(isIntervention) : [];
    } catch {
      return [];
    }
  }

  function readDetails(): Record<string, DetailState> {
    try {
      const value: unknown = JSON.parse(localStorage.getItem(detailsKey) ?? "{}");
      return typeof value === "object" && value !== null ? value as Record<string, DetailState> : {};
    } catch {
      return {};
    }
  }

  function defaultDetail(record: Intervention): DetailState {
    return {
      status: "registered",
      notes: "",
      evidence: [],
      events: [{
        id: `event-${record.id}`,
        label: "Intervención registrada",
        detail: `Registro creado por ${record.createdBy}`,
        createdAt: record.createdAt,
      }],
    };
  }

  function saveDetails(details: Record<string, DetailState>): boolean {
    try {
      localStorage.setItem(detailsKey, JSON.stringify(details));
      return true;
    } catch {
      if (pageMessage) pageMessage.textContent = "No se pudo guardar el cambio. El almacenamiento local puede estar lleno.";
      return false;
    }
  }

  function statusLabel(status: Status): string {
    return {
      registered: "Registrada",
      inspection: "En inspección",
      approved: "Aprobada",
      rejected: "Rechazada",
    }[status];
  }

  const record = readInterventions().find((item) => item.id === interventionId);

  if (!record || !detailContent || !notFound) {
    if (detailContent) detailContent.hidden = true;
    if (notFound) notFound.hidden = false;
  } else {
    const allDetails = readDetails();
    const details = allDetails[record.id] ?? defaultDetail(record);
    allDetails[record.id] = details;

    const setText = (selector: string, value: string): void => {
      const element = document.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };

    setText("#page-title", `${record.aircraft} · ${record.workOrder}`);
    setText("#page-subtitle", record.component);
    const editButton = document.querySelector<HTMLAnchorElement>("#edit-button");
    if (editButton) editButton.href = `/interventions/form/?id=${encodeURIComponent(record.id)}`;
    setText("#record-id", `ID ${record.id}`);
    setText("#aircraft", record.aircraft);
    setText("#component", record.component);
    setText("#work-order", record.workOrder);
    setText("#performed-at", formatDate(record.performedAt));
    setText("#created-by", record.createdBy);
    setText("#created-at", formatDate(record.createdAt));
    setText("#description", record.description);
    if (statusInput) statusInput.value = details.status;
    if (notesInput) notesInput.value = details.notes;

    function renderStatus(): void {
      if (!statusBadge) return;
      statusBadge.textContent = statusLabel(details.status);
      statusBadge.className = `status-pill status-${details.status}`;
    }

    function renderEvidence(): void {
      if (!evidenceList || !evidenceEmpty || !evidenceCount) return;
      evidenceList.replaceChildren();
      evidenceCount.textContent = `${details.evidence.length} ${details.evidence.length === 1 ? "archivo" : "archivos"}`;
      evidenceEmpty.hidden = details.evidence.length > 0;

      for (const item of details.evidence) {
        const row = document.createElement("div");
        row.className = "evidence-item";
        if (item.type.startsWith("image/")) {
          const preview = document.createElement("img");
          preview.src = item.dataUrl;
          preview.alt = "";
          row.append(preview);
        } else {
          const fileIcon = document.createElement("span");
          fileIcon.className = "file-icon";
          fileIcon.textContent = "PDF";
          row.append(fileIcon);
        }
        const info = document.createElement("div");
        info.className = "evidence-info";
        const name = document.createElement("strong");
        name.textContent = item.name;
        const date = document.createElement("small");
        date.textContent = `Agregado ${formatDate(item.addedAt)}`;
        info.append(name, date);
        const download = document.createElement("a");
        download.className = "download-link";
        download.href = item.dataUrl;
        download.download = item.name;
        download.textContent = "Descargar";
        row.append(info, download);
        evidenceList.append(row);
      }
    }

    function renderTimeline(): void {
      if (!timeline) return;
      timeline.replaceChildren();
      [...details.events].sort((first, second) => second.createdAt.localeCompare(first.createdAt)).forEach((event) => {
        const item = document.createElement("div");
        item.className = "timeline-item";
        const marker = document.createElement("span");
        marker.className = "timeline-marker";
        const content = document.createElement("div");
        const label = document.createElement("strong");
        label.textContent = event.label;
        const detail = document.createElement("p");
        detail.textContent = event.detail;
        const date = document.createElement("small");
        date.textContent = formatDate(event.createdAt);
        content.append(label, detail, date);
        item.append(marker, content);
        timeline.append(item);
      });
    }

    document.querySelector<HTMLButtonElement>("#save-status")?.addEventListener("click", () => {
      const nextStatus = statusInput?.value as Status;
      if (nextStatus === details.status) {
        if (pageMessage) pageMessage.textContent = "El estado no tuvo cambios.";
        return;
      }
      const previousStatus = statusLabel(details.status);
      details.status = nextStatus;
      details.events.push({
        id: crypto.randomUUID(),
        label: `Estado actualizado: ${statusLabel(nextStatus)}`,
        detail: `${previousStatus} → ${statusLabel(nextStatus)} por ${currentUser ?? "usuario demo"}`,
        createdAt: new Date().toISOString(),
      });
      if (saveDetails(allDetails)) {
        renderStatus();
        renderTimeline();
        if (pageMessage) pageMessage.textContent = "Estado actualizado correctamente.";
      }
    });

    document.querySelector<HTMLButtonElement>("#save-notes")?.addEventListener("click", () => {
      details.notes = notesInput?.value.trim() ?? "";
      if (saveDetails(allDetails) && pageMessage) pageMessage.textContent = "Observación guardada localmente.";
    });

    evidenceInput?.addEventListener("change", () => {
      const file = evidenceInput.files?.[0];
      if (!file) return;
      if (file.size > 1_500_000) {
        if (pageMessage) pageMessage.textContent = "El archivo supera el límite de 1.5 MB para este blueprint.";
        evidenceInput.value = "";
        return;
      }
      const reader = new FileReader();
      reader.addEventListener("load", () => {
        if (typeof reader.result !== "string") return;
        details.evidence.push({
          id: crypto.randomUUID(),
          name: file.name,
          type: file.type || "application/octet-stream",
          dataUrl: reader.result,
          addedAt: new Date().toISOString(),
        });
        details.events.push({
          id: crypto.randomUUID(),
          label: "Evidencia adjunta",
          detail: `${file.name} agregado por ${currentUser ?? "usuario demo"}`,
          createdAt: new Date().toISOString(),
        });
        if (saveDetails(allDetails)) {
          renderEvidence();
          renderTimeline();
          if (pageMessage) pageMessage.textContent = "Evidencia guardada localmente.";
        }
        evidenceInput.value = "";
      });
      reader.readAsDataURL(file);
    });

    renderStatus();
    renderEvidence();
    renderTimeline();
    saveDetails(allDetails);
  }
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #211b2e;
    background: #f6f5f8;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  :global(button), :global(input), :global(select), :global(textarea) { font: inherit; }
  .app-layout { min-height: 100vh; }
  .sidebar {
    position: fixed; inset: 0 auto 0 0; z-index: 1; display: flex; width: 254px;
    flex-direction: column; padding: 29px 17px 20px; border-right: 1px solid #49365c;
    background: linear-gradient(180deg, #2e2d4f 0%, #23103e 58%, #351070 100%);
  }
  .brand { display: block; width: 184px; margin: 2px 0 49px 8px; }
  .brand img { display: block; width: 100%; height: auto; }
  .nav-heading, .eyebrow { color: #d1c5df; font-size: .68rem; font-weight: 750; letter-spacing: .13em; }
  .nav-heading { margin: 0 11px 12px; }
  nav { display: grid; gap: 5px; }
  .nav-item { display: flex; min-height: 44px; align-items: center; gap: 12px; padding: 0 11px; border-radius: 8px; color: #eee8f5; font-size: .87rem; font-weight: 550; text-decoration: none; }
  .nav-item.active { border-left: 3px solid #b249f1; color: #fff; background: rgb(178 73 241 / 19%); font-weight: 700; }
  .nav-item.disabled { color: #c1b8ce; cursor: default; }
  .nav-icon { display: grid; width: 21px; place-items: center; color: inherit; font-size: 1.12rem; }
  .sidebar-footer { display: flex; align-items: center; gap: 9px; margin-top: auto; padding: 15px 8px 2px; border-top: 1px solid rgb(255 255 255 / 18%); color: #ded5e8; font-size: .73rem; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #05b179; }
  .main-area { min-height: 100vh; margin-left: 254px; }
  .topbar { display: flex; min-height: 72px; align-items: center; justify-content: space-between; gap: 16px; padding: 0 clamp(22px, 4vw, 56px); border-bottom: 1px solid #ece9f0; background: rgb(255 255 255 / 86%); }
  .breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; color: #352e3f; font-size: .82rem; font-weight: 650; }
  .breadcrumb a { color: #898191; text-decoration: none; }
  .breadcrumb span { color: #c5becb; }
  .account { display: flex; align-items: center; gap: 11px; }
  .account-avatar { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; color: #fff; background: linear-gradient(140deg, #b249f1, #7902ff); font-size: .82rem; font-weight: 700; }
  .account-email { color: #4c4457; font-size: .8rem; }
  .logout-button { margin-left: 7px; padding: 8px 11px; border: 1px solid #e8e3ec; border-radius: 7px; color: #62596d; background: #fff; cursor: pointer; font-size: .76rem; font-weight: 600; text-decoration: none; }
  .page-content { width: min(100%, 1160px); margin: 0 auto; padding: clamp(28px, 5vh, 52px) clamp(22px, 4vw, 56px) 70px; }
  .back-link { display: inline-block; margin-bottom: 24px; color: #60338f; font-size: .8rem; font-weight: 700; text-decoration: none; }
  .page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .heading-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .eyebrow { margin: 0 0 10px; color: #7902ff; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 8px; color: #30263c; font-size: clamp(1.65rem, 3vw, 2.15rem); letter-spacing: -.035em; }
  h2 { margin-bottom: 0; color: #30263c; font-size: 1.04rem; }
  h3 { margin-bottom: 10px; color: #4b4056; font-size: .82rem; }
  .intro { margin-bottom: 0; color: #827b8c; font-size: .88rem; }
  .status-pill { flex: 0 0 auto; margin-top: 8px; padding: 7px 12px; border: 1px solid; border-radius: 18px; font-size: .73rem; font-weight: 700; }
  .status-registered { border-color: #d8f1e8; color: #08774f; background: #effaf5; }
  .status-inspection { border-color: #f6dfb4; color: #9a5b00; background: #fff8e9; }
  .status-approved { border-color: #cfdcf8; color: #315da8; background: #f0f5ff; }
  .status-rejected { border-color: #f3caca; color: #a63e3e; background: #fff2f2; }
  .page-message { min-height: 20px; margin: -8px 0 12px; color: #08774f; font-size: .78rem; }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(270px, .85fr); align-items: start; gap: 18px; }
  .detail-main, .detail-side { display: grid; gap: 18px; }
  .panel { padding: 23px; border: 1px solid #ece8f0; border-radius: 10px; background: #fff; box-shadow: 0 3px 12px rgb(35 16 62 / 3%); }
  .panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; margin-bottom: 21px; }
  .panel-heading .eyebrow { margin-bottom: 8px; }
  .record-id, .panel-count { color: #968d9f; font-size: .72rem; }
  .details-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 24px; margin: 0; }
  .details-list div { min-width: 0; }
  dt { margin-bottom: 5px; color: #958c9f; font-size: .7rem; font-weight: 650; letter-spacing: .02em; }
  dd { margin: 0; color: #44394f; font-size: .84rem; font-weight: 650; overflow-wrap: anywhere; }
  .description-block { margin-top: 24px; padding-top: 19px; border-top: 1px solid #f0edf3; }
  .description-block p { margin-bottom: 0; color: #5c5364; font-size: .84rem; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
  .panel-intro { margin: 7px 0 17px; color: #827b8c; font-size: .78rem; line-height: 1.55; }
  .field-label { display: block; margin-bottom: 7px; color: #5a5064; font-size: .74rem; font-weight: 700; }
  select, textarea { width: 100%; border: 1px solid #ded8e5; border-radius: 7px; color: #40364b; background: #fff; font-size: .8rem; }
  select { height: 42px; padding: 0 11px; }
  textarea { display: block; min-height: 116px; padding: 11px; resize: vertical; line-height: 1.5; }

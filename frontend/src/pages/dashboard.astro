---
const logoPath = "/logos/logo-background-black-tracium.png";
import AccountMenu from "../components/AccountMenu.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#23103e" />
    <meta
      name="description"
      content="Dashboard de Tracium, plataforma de trazabilidad de mantenimiento aeronáutico."
    />
    <title>Dashboard | Tracium</title>
  </head>
  <body>
    <div class="app-layout">
      <aside class="sidebar">
        <a class="brand" href="/dashboard/" aria-label="Tracium, inicio">
          <img src={logoPath} alt="Tracium" />
        </a>

        <p class="nav-heading">ESPACIO DE TRABAJO</p>
        <nav aria-label="Menú principal">
          <a class="nav-item active" href="/dashboard/" aria-current="page">
            <span class="nav-icon" aria-hidden="true">⌂</span>
            Dashboard
          </a>
          <a class="nav-item" href="/interventions/">
            <span class="nav-icon" aria-hidden="true">▤</span>
            Intervenciones
          </a>
          <a class="nav-item" href="/inspections/">
            <span class="nav-icon" aria-hidden="true">✓</span>
            Inspecciones
          </a>
          <a class="nav-item" href="/audit/">
            <span class="nav-icon" aria-hidden="true">◷</span>
            Auditoría
          </a>
        </nav>

        <div class="sidebar-footer">
          <span class="status-dot" aria-hidden="true"></span>
          Entorno de demostración
        </div>
      </aside>

      <main class="main-area">
        <header class="topbar">
          <div class="breadcrumb"><a href="/dashboard/">Workspace</a><span aria-hidden="true">/</span>Dashboard</div>
          <AccountMenu />
        </header>

        <section class="dashboard-content" aria-labelledby="dashboard-title">
          <p class="eyebrow">ESPACIO DE TRABAJO</p>
          <h1 id="dashboard-title">Dashboard</h1>
          <p class="intro">Bienvenido a Tracium. Este es el resumen operativo de tu workspace.</p>

          <div class="metric-grid" aria-label="Indicadores operativos">
            <a class="metric-card" href="/interventions/">
              <span class="metric-label">Intervenciones</span>
              <strong id="metric-interventions">0</strong>
              <small id="metric-interventions-detail">Registros creados</small>
              <span class="metric-icon purple" aria-hidden="true">▤</span>
            </a>
            <a class="metric-card" href="/inspections/">
              <span class="metric-label">Pendientes de inspección</span>
              <strong id="metric-pending">0</strong>
              <small>Requieren revisión</small>
              <span class="metric-icon orange" aria-hidden="true">✓</span>
            </a>
            <a class="metric-card" href="/return-to-service/">
              <span class="metric-label">Retornos aprobados</span>
              <strong id="metric-approved">0</strong>
              <small>Listos para liberar</small>
              <span class="metric-icon green" aria-hidden="true">↗</span>
            </a>
            <a class="metric-card" href="/audit/">
              <span class="metric-label">Evidencias</span>
              <strong id="metric-evidence">0</strong>
              <small>Archivos asociados</small>
              <span class="metric-icon blue" aria-hidden="true">⌁</span>
            </a>
          </div>

          <div class="dashboard-grid">
            <section class="dashboard-panel" aria-labelledby="activity-title">
              <div class="panel-heading">
                <div><p class="eyebrow">SEGUIMIENTO</p><h2 id="activity-title">Actividad reciente</h2></div>
                <a href="/audit/">Ver auditoría →</a>
              </div>
              <div class="activity-list" id="activity-list"></div>
              <p class="activity-empty" id="activity-empty">Aún no hay actividad registrada.</p>
            </section>

            <aside class="dashboard-panel quick-panel" aria-labelledby="quick-title">
              <p class="eyebrow">ACCESOS RÁPIDOS</p>
              <h2 id="quick-title">Continúa tu trabajo</h2>
              <a class="quick-link" href="/interventions/form/"><span>＋</span><strong>Nueva intervención</strong><small>Registra un trabajo realizado</small></a>
              <a class="quick-link" href="/inspections/"><span>✓</span><strong>Revisar inspecciones</strong><small>Valida trabajos pendientes</small></a>
              <a class="quick-link" href="/return-to-service/"><span>↗</span><strong>Retorno al servicio</strong><small>Confirma una liberación</small></a>
            </aside>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<script>
  type Intervention = {
    id: string;
    aircraft: string;
    component: string;
    workOrder: string;
    createdAt: string;
    createdBy: string;
  };

  type TimelineEvent = {
    id: string;
    label: string;
    detail: string;
    createdAt: string;
  };

  type DetailState = {
    evidence?: unknown[];
    events?: TimelineEvent[];
  };

  type Inspection = { decision: string; updatedAt: string; inspector: string };
  type Approval = { decision: string; updatedAt: string; responsible: string };

  const sessionKey = "tracium-demo-user";
  const emailLabel = document.querySelector<HTMLSpanElement>("#account-email");
  const logoutButton = document.querySelector<HTMLButtonElement>("#logout-button");
  const email = localStorage.getItem(sessionKey);

  if (!email) {
    window.location.replace("/");
  } else if (emailLabel) {
    emailLabel.textContent = email;
  }

  if (!logoutButton) {
    throw new Error("No se pudo inicializar el botón para cerrar sesión.");
  }

  logoutButton.addEventListener("click", () => {
    localStorage.removeItem(sessionKey);
    window.location.replace("/");
  });

  function read<T>(key: string, fallback: T): T {
    try {
      return JSON.parse(localStorage.getItem(key) ?? JSON.stringify(fallback)) as T;
    } catch {
      return fallback;
    }
  }

  function isIntervention(value: unknown): value is Intervention {
    if (typeof value !== "object" || value === null) return false;
    const record = value as Record<string, unknown>;
    return ["id", "aircraft", "component", "workOrder", "createdAt", "createdBy"]
      .every((key) => typeof record[key] === "string");
  }

  const interventions = read<unknown[]>("tracium-interventions-v1", []).filter(isIntervention);
  const details = read<Record<string, DetailState>>("tracium-intervention-details-v1", {});
  const inspections = read<Record<string, Inspection>>("tracium-inspections-v1", {});
  const approvals = read<Record<string, Approval>>("tracium-approvals-v1", {});
  const pendingInspections = interventions.filter((record) => !inspections[record.id]).length;
  const approvedReturns = Object.values(approvals).filter((approval) => approval.decision === "approved").length;
  const evidenceCount = interventions.reduce((total, record) => total + (details[record.id]?.evidence?.length ?? 0), 0);

  const metricInterventions = document.querySelector<HTMLElement>("#metric-interventions");
  const metricPending = document.querySelector<HTMLElement>("#metric-pending");
  const metricApproved = document.querySelector<HTMLElement>("#metric-approved");
  const metricEvidence = document.querySelector<HTMLElement>("#metric-evidence");
  if (metricInterventions) metricInterventions.textContent = String(interventions.length);
  if (metricPending) metricPending.textContent = String(pendingInspections);
  if (metricApproved) metricApproved.textContent = String(approvedReturns);
  if (metricEvidence) metricEvidence.textContent = String(evidenceCount);

  function formatDate(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "Fecha no disponible";
    return new Intl.DateTimeFormat("es-MX", { dateStyle: "medium", timeStyle: "short" }).format(date);
  }

  const activity: Array<TimelineEvent & { recordId: string }> = [];
  for (const record of interventions) {
    activity.push({
      id: `created-${record.id}`,
      recordId: record.id,
      label: "Intervención registrada",
      detail: `${record.aircraft} · ${record.workOrder}`,
      createdAt: record.createdAt,
    });
    for (const event of details[record.id]?.events ?? []) {
      activity.push({ ...event, recordId: record.id });
    }
    const inspection = inspections[record.id];
    if (inspection) {
      activity.push({
        id: `inspection-${record.id}`,
        recordId: record.id,
        label: `Inspección ${inspection.decision}`,
        detail: `Revisada por ${inspection.inspector}`,
        createdAt: inspection.updatedAt,
      });
    }
    const approval = approvals[record.id];
    if (approval) {
      activity.push({
        id: `approval-${record.id}`,
        recordId: record.id,
        label: `Retorno al servicio ${approval.decision === "approved" ? "aprobado" : "rechazado"}`,
        detail: `Decisión de ${approval.responsible}`,
        createdAt: approval.updatedAt,
      });
    }
  }

  const activityList = document.querySelector<HTMLDivElement>("#activity-list");
  const activityEmpty = document.querySelector<HTMLParagraphElement>("#activity-empty");
  const recentActivity = activity.sort((first, second) => second.createdAt.localeCompare(first.createdAt)).slice(0, 6);
  if (activityList) {
    for (const event of recentActivity) {
      const item = document.createElement("a");
      item.className = "activity-item";
      item.href = `/interventions/detail/?id=${encodeURIComponent(event.recordId)}`;
      const marker = document.createElement("span");
      marker.className = "activity-marker";
      const content = document.createElement("span");
      content.className = "activity-content";
      const label = document.createElement("strong");
      label.textContent = event.label;
      const detail = document.createElement("small");
      detail.textContent = `${event.detail} · ${formatDate(event.createdAt)}`;
      content.append(label, detail);
      item.append(marker, content);
      activityList.append(item);
    }
  }
  if (activityEmpty) activityEmpty.hidden = recentActivity.length > 0;
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #211b2e;
    background: #f6f5f8;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .app-layout {
    min-height: 100vh;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 1;
    display: flex;
    width: 254px;
    flex-direction: column;
    padding: 29px 17px 20px;
    border-right: 1px solid #49365c;
    background: linear-gradient(180deg, #2e2d4f 0%, #23103e 58%, #351070 100%);
  }

  .brand {
    display: block;
    width: 184px;
    margin: 2px 0 49px 8px;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nav-heading,
  .eyebrow {
    color: #d1c5df;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.13em;
  }

  .nav-heading {
    margin: 0 11px 12px;
  }

  nav {
    display: grid;
    gap: 5px;
  }

  .nav-item {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 12px;
    padding: 0 11px;
    border-radius: 8px;
    color: #eee8f5;
    font-size: 0.87rem;
    font-weight: 550;
    text-decoration: none;
  }

  .nav-item.active {
    border-left: 3px solid #b249f1;
    color: #fff;
    background: rgb(178 73 241 / 19%);
    font-weight: 700;
  }

  .nav-item.disabled {
    color: #c1b8ce;
    cursor: default;
  }

  .nav-icon {
    display: grid;
    width: 21px;
    place-items: center;
    color: inherit;
    font-size: 1.12rem;
  }

  .coming-soon {
    margin-left: auto;
    color: #c1b8ce;
    font-size: 0.62rem;
  }

  .sidebar-footer {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: auto;
    padding: 15px 8px 2px;
    border-top: 1px solid rgb(255 255 255 / 18%);
    color: #ded5e8;
    font-size: 0.73rem;
  }

  .status-dot,
  .empty-badge span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #05b179;
  }

  .main-area {
    min-height: 100vh;
    margin-left: 254px;
  }

  .topbar {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 clamp(22px, 4vw, 56px);
    border-bottom: 1px solid #ece9f0;
    background: rgb(255 255 255 / 86%);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #352e3f;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .breadcrumb span:first-child {
    color: #898191;
    font-weight: 450;
  }

  .breadcrumb span:nth-child(2) {
    color: #c5becb;
  }

  .breadcrumb a {
    color: #898191;
    font-weight: 450;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #7902ff;
  }

  .account {
    display: flex;
    align-items: center;
    gap: 11px;
  }

  .account-avatar {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(140deg, #b249f1, #7902ff);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .account-email {
    color: #4c4457;
    font-size: 0.8rem;
  }

  .logout-button {
    margin-left: 7px;
    padding: 8px 11px;
    border: 1px solid #e8e3ec;
    border-radius: 7px;
    color: #62596d;
    background: #fff;
    cursor: pointer;
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none;
  }

  .logout-button:hover {
    border-color: #b249f1;
    color: #7902ff;
  }

  .logout-button:focus-visible,
  .brand:focus-visible,
  .nav-item:focus-visible {
    outline: 3px solid rgb(121 2 255 / 30%);
    outline-offset: 3px;
  }

  .dashboard-content {
    width: min(100%, 1050px);
    margin: 0 auto;
    padding: clamp(38px, 6vh, 65px) clamp(22px, 4vw, 56px);
  }

  .eyebrow {
    margin: 0 0 11px;
    color: #7902ff;
  }

  h1 {
    margin: 0;
    color: #23103e;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .intro {
    margin: 12px 0 36px;
    color: #797182;
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 18px;
  }

  .metric-card {
    position: relative;
    min-height: 142px;
    padding: 17px 16px;
    overflow: hidden;
    border: 1px solid #ece8f0;
    border-radius: 10px;
    color: inherit;
    background: #fff;
    text-decoration: none;
    transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
  }

  .metric-card:hover {
    border-color: #d8c4ec;
    box-shadow: 0 5px 16px rgb(35 16 62 / 7%);
    transform: translateY(-2px);
  }

  .metric-label,
  .metric-card strong,
  .metric-card small {
    display: block;
  }

  .metric-label {
    max-width: 120px;
    color: #766d80;
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .metric-card strong {
    margin-top: 12px;
    color: #30263c;
    font-size: 1.8rem;
    letter-spacing: -0.04em;
  }

  .metric-card small {
    margin-top: 4px;
    color: #a097a8;
    font-size: 0.67rem;
  }

  .metric-icon {
    position: absolute;
    right: 14px;
    top: 16px;
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    border-radius: 9px;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .metric-icon.purple { color: #7902ff; background: #f0e6fb; }
  .metric-icon.orange { color: #b56809; background: #fff4dc; }
  .metric-icon.green { color: #08774f; background: #eaf8f1; }
  .metric-icon.blue { color: #315da8; background: #edf3ff; }

  .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    gap: 18px;
  }

  .dashboard-panel {
    min-width: 0;
    padding: 22px;
    border: 1px solid #ece8f0;
    border-radius: 10px;
    background: #fff;
  }

  .panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
  }

  .panel-heading .eyebrow { margin-bottom: 7px; }

  .panel-heading h2,
  .quick-panel h2 {
    margin: 0;
    color: #30263c;
    font-size: 1.02rem;
  }

  .panel-heading a {
    color: #7902ff;
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .activity-list { display: grid; }

  .activity-item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 12px 0;
    border-bottom: 1px solid #f0edf3;
    color: inherit;
    text-decoration: none;
  }

  .activity-item:last-child { border-bottom: 0; }
  .activity-item:hover strong { color: #7902ff; }

  .activity-marker {
    width: 9px;
    height: 9px;
    flex: 0 0 auto;
    margin-top: 4px;
    border: 2px solid #eadcf5;
    border-radius: 50%;
    background: #7902ff;
  }

  .activity-content { min-width: 0; }
  .activity-content strong,
  .activity-content small { display: block; }
  .activity-content strong { color: #4a4054; font-size: 0.76rem; }
  .activity-content small { margin-top: 4px; color: #958c9f; font-size: 0.69rem; overflow-wrap: anywhere; }
  .activity-empty { margin: 20px 0 4px; color: #958c9f; font-size: 0.78rem; }
  .activity-empty[hidden] { display: none; }

  .quick-panel .eyebrow { margin-bottom: 7px; }
  .quick-link { display: grid; grid-template-columns: 31px 1fr; column-gap: 10px; align-items: center; margin-top: 15px; color: inherit; text-decoration: none; }
  .quick-link > span { grid-row: span 2; display: grid; width: 31px; height: 31px; place-items: center; border-radius: 8px; color: #7902ff; background: #f0e6fb; font-size: 1.1rem; }
  .quick-link strong { color: #4a4054; font-size: 0.75rem; }
  .quick-link small { margin-top: 3px; color: #958c9f; font-size: 0.67rem; }
  .quick-link:hover strong { color: #7902ff; }

  .empty-state {
    display: flex;
    min-height: 330px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    border: 1px dashed #dcd5e4;
    border-radius: 13px;
    background: rgb(255 255 255 / 78%);
    text-align: center;
  }

  .empty-icon {
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    margin-bottom: 21px;
    border-radius: 18px;
    background: #f4ebff;
  }

  .empty-icon svg {
    width: 40px;
    stroke: #7902ff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .empty-icon rect {
    stroke: #c99df4;
    stroke-width: 1.5;
  }

  .empty-state h2 {
    margin: 0;
    color: #30263c;
    font-size: 1.08rem;
    font-weight: 680;
  }

  .empty-state > p {
    max-width: 455px;
    margin: 10px 0 19px;
    color: #827b8c;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .empty-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid #e9e5ee;
    border-radius: 20px;
    color: #726a7c;
    background: #fff;
    font-size: 0.72rem;
  }

  .empty-badge span {
    width: 7px;
    height: 7px;
    background: #aaa4b0;
  }

  @media (max-width: 760px) {
    .sidebar {
      inset: auto 0 0;
      width: auto;
      height: 70px;
      flex-direction: row;
      align-items: center;
      padding: 7px 12px;
      border-top: 1px solid #49365c;
      border-right: 0;
    }

    .brand,
    .nav-heading,
    .sidebar-footer,
    .coming-soon {
      display: none;
    }

    .sidebar nav {
      display: flex;
      width: 100%;
      justify-content: space-around;
      gap: 3px;
    }

    .nav-item {
      min-height: 44px;
      flex-direction: column;
      justify-content: center;
      gap: 1px;
      padding: 3px 10px;
      font-size: 0.63rem;
    }

    .nav-icon {
      font-size: 1rem;
    }

    .main-area {
      min-height: calc(100vh - 70px);
      margin-left: 0;
      padding-bottom: 70px;
    }

    .topbar {
      min-height: 64px;
      padding: 0 18px;
    }

    .account {
      gap: 8px;
    }

    .account-email {
      display: none;
    }

    .logout-button {
      margin-left: 0;
      padding: 7px 9px;
    }

    .dashboard-content {
      padding: 38px 20px;
    }

    .metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .empty-state {
      min-height: 300px;
    }
  }
</style>

---
const logoPath = "/logos/logo-background-black-tracium.png";
---

<!doctype html>
<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="theme-color" content="#23103e" /><title>Recuperar acceso | Tracium</title></head>
<body><main class="auth-layout"><section class="brand-panel"><div><img src={logoPath} alt="Tracium" /><p class="eyebrow">ACCESO SEGURO</p><h1>Recupera el control de tu cuenta.</h1><p>Solicita un enlace de recuperación para continuar con tu trabajo de trazabilidad.</p></div></section><section class="form-panel"><div class="auth-card"><a class="back-link" href="/">← Volver al inicio de sesión</a><p class="eyebrow">RECUPERACIÓN DE ACCESO</p><h2>¿Olvidaste tu contraseña?</h2><p class="intro">Indica el correo de tu cuenta demo y registraremos la solicitud en este navegador.</p><form id="reset-form"><label for="email">Correo electrónico</label><input id="email" type="email" required placeholder="nombre@empresa.com" /><button type="submit">Solicitar recuperación <span>→</span></button><p class="form-status" id="form-status" role="status"></p></form><p class="auth-note">En este blueprint no se envían correos reales. La solicitud queda disponible para la futura integración.</p></div><p class="copyright">© {new Date().getFullYear()} Tracium</p></section></main></body></html>

<script>
  const form = document.querySelector<HTMLFormElement>("#reset-form")!; const email = document.querySelector<HTMLInputElement>("#email")!; const status = document.querySelector<HTMLParagraphElement>("#form-status")!;
  form.addEventListener("submit", (event) => { event.preventDefault(); if (!email.value.trim() || !email.validity.valid) { status.textContent = "Ingresa un correo electrónico válido."; return; } const key = "tracium-password-resets-v1"; let requests: Array<{ email: string; requestedAt: string }> = []; try { requests = JSON.parse(localStorage.getItem(key) ?? "[]") as Array<{ email: string; requestedAt: string }>; } catch { requests = []; } requests.push({ email: email.value.trim().toLowerCase(), requestedAt: new Date().toISOString() }); localStorage.setItem(key, JSON.stringify(requests)); status.textContent = "Solicitud registrada. En una integración real recibirías un enlace por correo."; form.reset(); });
</script>

<style>
  :global(*){box-sizing:border-box}:global(body){min-width:320px;min-height:100vh;margin:0;color:#211b2e;background:#f6f5f8;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}:global(button),:global(input){font:inherit}.auth-layout{display:grid;min-height:100vh;grid-template-columns:minmax(360px,.9fr) minmax(460px,1.1fr)}.brand-panel{display:flex;align-items:center;padding:64px clamp(40px,7vw,112px);color:#fff;background:linear-gradient(145deg,#23103e 0%,#2e2d4f 64%,#351070 100%)}.brand-panel img{width:220px;max-width:100%;margin-bottom:90px}.brand-panel .eyebrow,.eyebrow{color:#b249f1;font-size:.68rem;font-weight:750;letter-spacing:.13em}.brand-panel h1{max-width:430px;margin:12px 0;color:#fff;font-size:clamp(2rem,4vw,3.2rem);letter-spacing:-.04em}.brand-panel p:not(.eyebrow){max-width:390px;color:#d1c5df;font-size:.95rem;line-height:1.65}.form-panel{display:flex;align-items:center;justify-content:center;padding:50px 30px}.auth-card{width:min(100%,430px)}.back-link{display:inline-block;margin-bottom:58px;color:#60338f;font-size:.8rem;font-weight:700;text-decoration:none}.eyebrow{margin:0 0 11px;color:#7902ff}.auth-card h2{margin:0;color:#30263c;font-size:clamp(1.7rem,3vw,2.3rem);letter-spacing:-.035em}.intro{margin:12px 0 29px;color:#827b8c;font-size:.88rem;line-height:1.6}label{display:block;margin-bottom:7px;color:#51465d;font-size:.76rem;font-weight:700}input{width:100%;height:45px;padding:0 12px;border:1px solid #ded8e5;border-radius:7px;color:#40364b;background:#fff;font-size:.82rem}input:focus{outline:3px solid #7902ff24;border-color:#b249f1}button{width:100%;height:45px;margin-top:20px;border:1px solid #7902ff;border-radius:7px;color:#fff;background:#7902ff;cursor:pointer;font-size:.8rem;font-weight:700}button:hover{background:#6400d9}.form-status{min-height:42px;margin:15px 0 0;color:#08774f;font-size:.78rem;line-height:1.5}.auth-note{margin:31px 0 0;padding-top:20px;border-top:1px solid #eeeaf2;color:#827b8c;font-size:.78rem;line-height:1.55}.copyright{margin-top:30px;color:#a39cab;font-size:.74rem}@media(max-width:760px){.auth-layout{display:block}.brand-panel{min-height:240px;padding:32px 25px}.brand-panel img{width:170px;margin-bottom:35px}.brand-panel h1{font-size:2rem}.brand-panel p:not(.eyebrow){display:none}.form-panel{padding:40px 25px}.back-link{margin-bottom:42px}}
</style>
